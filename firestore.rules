rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Kullanıcı profilleri ───────────────────────────────
    match /userProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Çok-çiftlik istekleri ──────────────────────────────
    match /multiFarmRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && (request.auth.token.isSuperAdmin == true
            || resource.data.userId == request.auth.uid);
    }

    // ── Davet kodları ──────────────────────────────────────
    match /farmInvites/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Çiftlik verileri ───────────────────────────────────
    match /farms/{farmId} {

      // Herhangi bir giriş yapmış kullanıcı çiftlik oluşturabilir
      allow create: if request.auth != null;

      // Okuma/güncelleme: kişisel alan veya üye
      allow read, update: if request.auth != null
        && (farmId == request.auth.uid
            || exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)));

      // Silme: sadece sahip
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // Alt koleksiyonlar (animals, vehicles, buildings, stock, documents, members ...)
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
          && (farmId == request.auth.uid
              || exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid))
              || (subcollection == 'members' && docId == request.auth.uid));
      }

      // Aktivite log kayıtları
      match /activityLogs/{logId} {
        allow read, write: if request.auth != null
          && (farmId == request.auth.uid
              || exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)));
      }
    }

    // ── Uygulama duyuruları (tüm giriş yapmış kullanıcılar okuyabilir) ──
    match /app_announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Satış Transfer Talepleri ─────────────────────────
    match /saleTransfers/{transferId} {
      // Herhangi bir giriş yapmış kullanıcı oluşturabilir
      allow create: if request.auth != null;
      // Satıcı veya alıcı okuyabilir/güncelleyebilir
      allow read: if request.auth != null
        && (resource.data.sellerUserId == request.auth.uid
            || resource.data.buyerEmail == request.auth.token.email);
      allow update: if request.auth != null
        && (resource.data.sellerUserId == request.auth.uid
            || resource.data.buyerEmail == request.auth.token.email);
      allow delete: if request.auth != null
        && resource.data.sellerUserId == request.auth.uid;
    }

    // ── OTA Yama Notlari ─────────────────────────
    // Sadece surum notlari icerir, hassas veri yok. Giris yapmamis
    // kullanicinin da guncelleme uyarisini gorebilmesi icin acik okuma.
    match /appUpdates/{platform} {
      allow read: if true;
      allow write: if false;
    }

    // Diğer tüm yollar yasak
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
